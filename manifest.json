{
    "manifest_version": 3,
    "name": "Link Librarian",
    "version": "1.0.1",
    "description": "Save link with content - Remember exactly what you want to read later",
    "permissions": [
        "storage",
        "contextMenus",
        "activeTab",
        "tabs",
        "notifications",
        "scripting"
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "Link Librarian"
    },
    "icons": {
        "16": "icons/icon16.png",
        "64": "icons/icon64.png",
        "128": "icons/icon128.png"
    }
}